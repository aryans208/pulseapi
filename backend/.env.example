# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pulseapi_db
DB_CONNECTION_LIMIT=10
DB_SSL=false
# For Aiven, set DB_SSL=true and provide either the CA certificate contents or a local file path.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=C:\path\to\ca.pem

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_pulseapi_production_grade_32chars!
JWT_EXPIRES_IN=7d

# Monitoring Cron Schedule (Default: checks every minute)
CRON_SCHEDULE=* * * * *

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
